      RowBox[{
       RowBox[{"-", "5"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Theta]", "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], ")"}], "^", "2"}]}], "]"}]}], "}"}], 
