Cell[BoxData[
 RowBox[{
  RowBox[{"Uc2", "[", 
   RowBox[{
   "\[Theta]_", ",", "\[Theta]TCJ_", ",", " ", "\[Theta]an_", ",", " ", "k_", 
    ",", " ", "k2_"}], "]"}], ":=", " ", 
  RowBox[{"Exp", "[", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k2", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "\[Theta]TCJ"}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"k", "/", "2"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", "\[Theta]an"}], "]"}]}]}], ")"}], 
       RowBox[{"Cos", "[", 
        RowBox[{"2", "\[Theta]"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k2", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "\[Theta]TCJ"}], "]"}]}], "+", " ", 
         RowBox[{
          RowBox[{"k", "/", "2"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "\[Theta]an"}], "]"}]}]}], ")"}], 
       RowBox[{"Sin", "[", 
        RowBox[{"2", "\[Theta]"}], "]"}]}]}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7975946018637094`*^9, 
  3.7975946128423147`*^9}},ExpressionUUID->"6204b1e0-bc59-492c-9f99-\
4b1143e7c2b5"],

