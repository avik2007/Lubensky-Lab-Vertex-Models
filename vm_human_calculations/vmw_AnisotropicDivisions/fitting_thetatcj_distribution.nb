Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindMinimum", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Res", "[", "\[Phi]", "]"}], ",", " ", 
     RowBox[{"0", "\[LessEqual]", " ", "\[Phi]", " ", "\[LessEqual]", " ", 
      RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", " ", "1.0"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.794069691241438*^9, 
  3.7940697033714604`*^9}},ExpressionUUID->"5622e14e-4fd0-4572-b50c-\
f9361a65deef"],

