}, Open  ]],

Cell[TextData[{
 "Fit parameters for Gaussian: A Exp[-( x - \[Pi]/2 ) / (2 \[Sigma]2)] + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "0"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "f5be9fea-2d74-410a-963a-7501472c1e38"],
 " "
}], "Text",
 CellChangeTimes->{{3.79407032109803*^9, 
  3.794070387392234*^9}},ExpressionUUID->"183c7c7c-c215-4f78-bf3e-\
e88524de2d31"],

Cell[TextData[{
 "I fitted for 3 parameters because I know that the maximum of the initial \
probability distribution was \[Pi]/2. I also fitted for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e275d25d-9ea1-46f7-998f-71f278566029"],
 " instead of \[Sigma], just in case it made the solver\[CloseCurlyQuote]s \
job easier.\n\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "0"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "16227c31-6973-4d56-abe2-a2eade83ea79"],
 " = 0.092107\nA = 0.586627\n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "411637d8-d57d-4b9e-b597-6b3c88946063"],
 "= 0.23405\n\nI also truncated to 6 sig figs since it did not affect the fit \
that much.\n\nUntruncated Residual:"
}], "Text",
 CellChangeTimes->{{3.7940704727309284`*^9, 
  3.794070626502433*^9}},ExpressionUUID->"7ca65f17-fcef-4b58-9b46-\
6ea1849f185f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Res2", "[", "\[Phi]_", "]"}], " ", ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", "3.977463260506422", ")"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", "\[Phi]"}], "]"}]}], "]"}]}], " ", "-", "  ", 
   "0.09210758442693216`", "\[VeryThinSpace]", "-", 
   RowBox[{"0.5866273359249808`", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "2.136298328298766`"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1.5707963663387658`"}], "+", "\[Phi]"}], ")"}], 
       "2"]}]]}]}]}]], "Input",
 CellChangeTimes->{{3.7940706408757534`*^9, 3.794070670535624*^9}, {
  3.7940707105903797`*^9, 
  3.7940707110481157`*^9}},ExpressionUUID->"0902271f-d4d4-4ff6-9c34-\
16b546fb2d1b"],

