%% Sweeping Abox plot, March Meeting 
subgplotlabelindex_x = 3.73;
subgplotlabelindex_y = 3.7;
subgplotlabelfontsize = 20;
plot_width = 750;
plot_height = 550;
horizontal_title_x = 3.715;
horizontal_title_y = 0.5;
quadratic_title_y_offset = 0.1;
log_title_y_offset = -0.1;
exp_title_y_offset = -0.1;
title_font = 18;
legend_font = 20;
markersize = 10;
xlabelfont = 24;
ylabelfont = 20;
xtickfont = 20;
ytickfont = 20;
%subplot(3,2,1) % first low polydispersity Tiss case
color = [0 0.35 0];
hF = gcf;
hF.Position(1:4) = [0 0 plot_width plot_height];

K = 50 / sqrt(1250);
t = tiledlayout(1,1);
load('SWAB_dE/smdataSWAB.mat');

ax1 = axes(t);
errorbar(ax1, p0smSWAB(:,1), 1*p0smSWAB(:,2)/ K, 1*SMvarSWAB/ K, 'o', 'MarkerSize', markersize, 'MarkerEdgeColor',color, 'Color',color, 'MarkerFaceColor', color );


ylim(ax1, [-0.5 2.6])
yticks(ax1, -0.5:0.5:2.5)
%yticklabels(ax1, {'-0.5','0', '0.5', '1.0', '1.5', '2.0', '2.5', '3.0'})
xticks(ax1, 3.75:0.03:3.9)
grid on;
ax1.XAxis.FontSize = xtickfont;
ax1.YAxis.FontSize = ytickfont;

ax2 = axes(t);
ax2.XAxis.FontSize = xtickfont-2;
ax2.XAxisLocation = 'top';
set(ax2, 'color', 'none');
set(ax2, 'ytick', []);
ax2.XDir = 'reverse';
S0 = 3.75:0.03:3.90;

P0 = 135;
Abox = P0^2 ./ S0.^2;
xlim(ax2, [1198 1296])
xticks(ax2, 1198:(1296-1198)/5:1296);
%xticklabels(ax2, {'1296', '1276', '1256', '1236', '1217', '1198'})

ylabel(ax1, {'$\textbf{Dimensionless}$'; '$\textbf{Shear Modulus}$'}, 'Interpreter', 'Latex', 'FontSize', ylabelfont, 'FontName', 'Times New Roman');
xlabel(ax1, '$ \mathbf{\frac{P_0}{\sqrt{A_{avg} }}}$', 'Interpreter', 'latex', 'FontSize', xlabelfont, 'FontName','Times New Roman');
xlabel(ax2, '$ \mathbf{A_{box}}$ (pixels)', 'Interpreter', 'latex', 'FontSize', xlabelfont-2, 'FontName', 'Times New Roman');
title('$\Longrightarrow$ decreasing $ \mathbf{A_{box }} $ (Compression) $ \Longrightarrow$ ', 'Interpreter', 'latex', 'FontSize', xlabelfont, 'FontName', 'Times New Roman');
savefig('marchmeeting_SWAB.fig')
exportgraphics(gcf, 'marchmeeting_SWAB.pdf', 'ContentType', 'vector')
