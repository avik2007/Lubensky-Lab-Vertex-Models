K = 50 / sqrt(1250);
%% First shear modulus plot, just to demonstrate the phase transition 
xlabelfont = 24;
ylabelfont = 20;
xtickfont = 20;
ytickfont = 20;
legendfontsize=20;
plot_width = 600;
plot_height = 400;
hF = gcf;
hF.Position(1:4) = [0 0 plot_width plot_height];

load('T2ss_dE/smdata7.mat')
errorbar(p0sm(:,1), 1*p0sm(:,2) / K, 1*SMvar / K, 'o', 'MarkerSize', 10, 'MarkerEdgeColor', 'blue', 'Color', 'blue', 'MarkerFaceColor', 'blue' )
ax=gca;
ax.XAxis.FontSize = xtickfont;
ax.YAxis.FontSize = ytickfont;
ylabel({'$\textbf{Dimensionless}$'; '$\textbf{Shear Modulus}$'}, 'Interpreter', 'Latex', 'FontSize', ylabelfont, 'FontName', 'Times New Roman');
xlabel('$ \mathbf{\frac{P_0}{\sqrt{A_{0} }}}$', 'Interpreter', 'latex', 'FontSize', xlabelfont, 'FontName','Times New Roman');

ylim([-0.5 2.6]);
yticks(-0.5:0.5:2.6);
xlim([3.75 3.903]);
yticklabels({'-0.5','0', '0.5', '1.0', '1.5', '2.0', '2.5'});
xticks(3.75:0.03:3.9);

grid on;
savefig('marchmeeting_simple_shearmoduli_plot.fig')
exportgraphics(gcf, 'marchmeeting_simple_shearmoduli_plot.pdf', 'ContentType', 'vector')
hold off;

