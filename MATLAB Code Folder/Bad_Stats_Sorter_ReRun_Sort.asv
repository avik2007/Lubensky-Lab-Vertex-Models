filename = "L2Ex_LP"

files_str = strcat(filename, "_file_srt_names.txt")

str = readlines(files_str);

files_mem = strcat(filename, "_file_srt_mems.txt");
[~, f,ext] = fileparts(files_mem);

fid = fopen(files_mem, 'r');
formatspec = "%d\n";
sizeA = [1 inf];

A = fscanf(fid, formatspec, sizeA);
A = A';

new_file = "parameters_rerun.txt";
pfid = fopen(new_file, 'wt');

for id = 1:length(A)
    if (A(id, 1) < 20)
        this_string = split(str(id,1), "_");
        this_string = strjoin(this_string(1:10), "_");
        new_suffix = "_EQ.txt";
        this_string_new_suffix =strcat(this_string, new_suffix, "\t", this_string,"\n");
        fprintf(pfid, this_string_new_suffix);
    end
end

        